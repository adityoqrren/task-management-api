  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "dotenv -e .env.dev -- nodemon src/app.js",
    "dev:production": "dotenv -e .env.production -- nodemon src/app.js",
    "start": "node src/app.js",
    "prisma": "prisma",
    "test:rate-limit": "node --env-file=.env.test tests/rateLimiter.test.js",
    "test:member-active": "node --experimental-test-module-mocks --test tests/memberActiveStatus.test.js",
    "prisma:format:dev": "dotenv -e .env.dev -- prisma format",
    "prisma:validate:dev": "dotenv -e .env.dev -- prisma validate",
    "prisma:migrate:dev": "dotenv -e .env.dev -- prisma migrate dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@aws-sdk/s3-request-presigner": "^3.901.0",
    "@prisma/client": "^6.6.0",
    "amqplib": "^0.10.9",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "rate-limit-redis": "^4.3.1",
    "redis": "^4.7.0",
    "sanitize-html": "^2.17.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.0.0",
    "nodemon": "^3.1.10",
    "prisma": "^6.6.0"
  }
