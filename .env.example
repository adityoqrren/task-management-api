# Runtime
NODE_ENV=development
PORT=3000

# Production only: value passed to Express "trust proxy"
# REMOTE_ADDRESS=1

# Database (docker-compose exposes PostgreSQL on host port 5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/taskdb?schema=public"

# JWT secrets
ACCESS_TOKEN_SECRET=replace-with-a-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-random-secret
WS_TOKEN_SECRET=replace-with-a-random-secret

# Legacy: present in existing env files, not referenced by current code
# JWT_SECRET=

# Redis
REDIS_SERVER=localhost #replace with 'redis' for production if deployed in docker
REDIS_PORT=6379

# RabbitMQ (required at startup)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Cloudflare R2
R2_REGION=auto
R2_ACCOUNT_ID=replace-with-account-id
R2_ACCESS_KEY_ID=replace-with-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-secret-access-key
R2_BUCKET_NAME=replace-with-bucket-name

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret
TURNSTILE_ALLOWED_HOSTNAMES=localhost,example.com

# Secret used to hash account identifiers for login protection
LOGIN_RATE_LIMIT_SECRET=replace-with-a-random-secret

# Tests (optional)
# TEST_BASE_URL=http://localhost:3000
# TEST_COOKIE=
# PROTECTION_TEST_PORT=3999
